# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Monorepo sources (the chart only ships templates + values)
apps/
packages/
.github/
docs/
node_modules/
.turbo/
package.json
package-lock.json
turbo.json
npm-shrinkwrap.json
Dockerfile
