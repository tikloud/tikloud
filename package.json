{
  "name": "tikloud",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=landing-page",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:docs": "turbo run dev --filter=docs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
